{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-stack": {
      "source": {
        "source": "github",
        "repo": "nikita-simankov/claude-stack"
      }
    }
  },
  "enabledPlugins": {
    "stack@claude-stack": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm playwright test:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(buf lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(mkdir -p .claude:*)",
      "Bash(echo red > .claude/tdd-phase)",
      "Bash(echo green > .claude/tdd-phase)",
      "Bash(echo refactor > .claude/tdd-phase)",
      "Bash(rm -f .claude/tdd-phase)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)"
    ]
  }
}
